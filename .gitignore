# The rendered site. Generated by build_site.py and published straight to
# Pages by .github/workflows/deploy-pages.yml, so it is never committed: it is
# ~22 MB and is rewritten in full on every content refresh, which added about a
# gigabyte of history a year for a file reproducible from data/ at any commit.
/index.html

# Firecrawl cache
.firecrawl/

# Downloaded raw image cache (regenerable via build_images.py)
data/img_cache/

# Python
__pycache__/
*.pyc

# OS
Thumbs.db
.DS_Store

# Editor
.vscode/
.idea/

# Node (if tooling added later)
node_modules/
